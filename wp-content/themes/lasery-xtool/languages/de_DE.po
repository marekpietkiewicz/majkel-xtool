msgid "LASERY I URZĄDZENIA XTOOL"
msgstr "XTOOL LASER UND GERÄTE"

msgid "Twórz więcej. Z xTool."
msgstr "Mehr gestalten. Mit xTool."

msgid "Poznaj urządzenia do grawerowania i cięcia. Wybierz model dla siebie lub zapytaj nas o demo."
msgstr "Entdecken Sie Geräte zum Gravieren und Schneiden. Wählen Sie ein Modell oder fragen Sie eine Demo an."

msgid "Zobacz produkty"
msgstr "Produkte ansehen"

msgid "OD POMYSŁU DO REALIZACJI"
msgstr "VON DER IDEE ZUR UMSETZUNG"

msgid "KATALOG XTOOL"
msgstr "XTOOL KATALOG"

msgid "Znajdź urządzenie dla siebie."
msgstr "Finden Sie das passende Gerät."

msgid "Poznaj dostępne urządzenia i wybierz rozwiązanie do swoich projektów."
msgstr "Entdecken Sie die verfügbaren Geräte und wählen Sie eine Lösung für Ihre Projekte."

msgid "Zobacz cały katalog"
msgstr "Gesamten Katalog ansehen"

msgid "Katalog produktów jest w przygotowaniu. Skontaktuj się z nami, aby zapytać o urządzenia."
msgstr "Der Produktkatalog wird vorbereitet. Kontaktieren Sie uns für Fragen zu den Geräten."

msgid "POZNAJ XTOOL"
msgstr "XTOOL ENTDECKEN"

msgid "Chcesz zobaczyć urządzenie w akcji?"
msgstr "Möchten Sie ein Gerät in Aktion sehen?"

msgid "Wybierz dogodny termin na stronie demonstracji xTool lub otwórz ją w nowej karcie."
msgstr "Wählen Sie auf der xTool-Demoseite einen passenden Termin oder öffnen Sie diese in einem neuen Tab."

msgid "Otwórz rezerwację demo"
msgstr "Demo-Buchung öffnen"

msgid "Formularz „Book a Service” znajduje się poniżej profilu na stronie xTool. Przewiń zawartość ramki, aby go zobaczyć."
msgstr "Das Formular „Book a Service“ befindet sich unter dem Profil auf der xTool-Seite. Scrollen Sie innerhalb des Rahmens, um es zu sehen."

msgid "Rezerwacja demonstracji xTool u Michała"
msgstr "xTool-Demonstration bei Michał buchen"

