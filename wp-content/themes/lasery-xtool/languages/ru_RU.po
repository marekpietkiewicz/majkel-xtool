msgstr "ЛАЗЕРЫ И ОБОРУДОВАНИЕ XTOOL"

msgid "Twórz więcej. Z xTool."
msgstr "Создавайте больше. С xTool."

msgid "Poznaj urządzenia do grawerowania i cięcia. Wybierz model dla siebie lub zapytaj nas o demo."
msgstr "Изучите оборудование для гравировки и резки. Выберите модель или узнайте о демонстрации."

msgid "Zobacz produkty"
msgstr "Посмотреть товары"

msgid "OD POMYSŁU DO REALIZACJI"
msgstr "ОТ ИДЕИ К ВОПЛОЩЕНИЮ"

msgid "KATALOG XTOOL"
msgstr "КАТАЛОГ XTOOL"

msgid "Znajdź urządzenie dla siebie."
msgstr "Найдите подходящее оборудование."

msgid "Poznaj dostępne urządzenia i wybierz rozwiązanie do swoich projektów."
msgstr "Изучите доступное оборудование и выберите решение для своих проектов."

msgid "Zobacz cały katalog"
msgstr "Посмотреть весь каталог"

msgid "Katalog produktów jest w przygotowaniu. Skontaktuj się z nami, aby zapytać o urządzenia."
msgstr "Каталог товаров готовится. Свяжитесь с нами, чтобы узнать об оборудовании."

msgid "POZNAJ XTOOL"
msgstr "УЗНАЙТЕ ОБ XTOOL"

