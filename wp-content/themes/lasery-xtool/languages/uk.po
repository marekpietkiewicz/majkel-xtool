msgstr "Розширте можливості пристрою."

msgid "Strona główna"
msgstr "Головна"

msgid "Twórz więcej. Z xTool."
msgstr "Створюйте більше. З xTool."

msgid "Urządzenia"
msgstr "Пристрої"

msgid "Urządzenia xTool"
msgstr "Пристрої xTool"

msgid "Urządzenia xTool do grawerowania i cięcia laserowego. Pokażemy je na demo i pomożemy w zamówieniu."
msgstr "Пристрої xTool для лазерного гравіювання та різання. Покажемо їх на демо й допоможемо із замовленням."

msgid "Urządzenie"
msgstr "Пристрій"

msgid "Wstrzymaj"
msgstr "Пауза"

msgid "Wszystkie"
msgstr "Усі"

msgid "Wszystkie produkty"
msgstr "Усі товари"

msgid "Wybierz dogodny termin na stronie demonstracji xTool lub otwórz ją w nowej karcie."
msgstr "Оберіть зручний час на сторінці демонстрації xTool або відкрийте її в новій вкладці."

msgid "Wybierz termin i urządzenie w kalendarzu xTool."
msgstr "Оберіть дату й пристрій у календарі xTool."

msgid "Wyniki wyszukiwania: %s"
msgstr "Результати пошуку: %s"

msgid "Wyróżnione produkty"
msgstr "Рекомендовані товари"

msgid "Wyślij formularz – potwierdzimy cenę i prześlemy link do płatności."
msgstr "Надішліть форму — ми підтвердимо ціну й надішлемо посилання для оплати."

msgid "Zamów"
msgstr "Замовити"

msgid "Zamówienia realizujemy w oficjalnym sklepie xTool."
msgstr "Замовлення оформлюємо в офіційному магазині xTool."

msgid "Zamówienie bez konta"
msgstr "Замовлення без реєстрації"

msgid "Zamówienie bez zakładania konta"
msgstr "Замовлення без створення облікового запису"

msgid "Zapytaj o demo"
msgstr "Дізнатися про демонстрацію"

msgid "Zdjęcie produktu %d"
msgstr "Фотографія товару %d"

msgid "Zdjęcie produktu {{index}}"
msgstr "Фото товару {{index}}"

msgid "Znajdź urządzenie dla siebie."
msgstr "Знайдіть обладнання для себе."

msgid "Zobacz cały katalog"
msgstr "Переглянути весь каталог"

msgid "Zobacz laser w akcji i zadaj pytania."
msgstr "Подивіться лазер у роботі й поставте запитання."

msgid "Zobacz szczegóły"
msgstr "Переглянути деталі"

msgid "Zobacz urządzenie w akcji podczas spotkania online i zadaj pytania."
msgstr "Подивіться пристрій у роботі під час онлайн-зустрічі та поставте запитання."

msgid "od %s"
msgstr "від %s"

msgid "xTool i nazwy produktów są znakami towarowymi ich właścicieli."
msgstr "xTool і назви товарів є торговельними марками їхніх власників."

msgid "Ścieżka nawigacji"
msgstr "Навігаційний ланцюжок"
